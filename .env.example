# Second Brain – environment template
# Copy to .env and fill in real values: cp .env.example .env

# Server
PORT=8080

# Gemini (required for chat/embed)
GOOGLE_API_KEY=your-google-api-key

# Optional: Gemini model overrides
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_TEMPERATURE=0.7

# Optional: Notion (user profile / UpsertUserFact)
# NOTION_TOKEN=your-notion-token
# NOTION_USER_PROFILE_PAGE_ID=your-profile-page-id

# Optional: Qdrant (SearchKnowledgeBase)
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6334
# QDRANT_COLLECTION=knowledge
