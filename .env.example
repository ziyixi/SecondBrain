# Second Brain – environment template
# Copy to .env and fill in real values: cp .env.example .env
# Only GOOGLE_API_KEY is required for basic chat; other vars enable features or tune behavior.

# Server
PORT=8080

# Gemini (required for chat/embed)
GOOGLE_API_KEY=your-google-api-key

# Optional: Gemini model overrides (GEMINI_MAX_OUTPUT_TOKENS / GEMINI_TEMPERATURE also used as chat defaults when request omits them)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_MAX_OUTPUT_TOKENS=2048
# GEMINI_TEMPERATURE=0.7

# Optional: Notion (user profile / UpsertUserFact). See README "Setting up Notion" for token, page ID, and sharing.
# NOTION_TOKEN=your-notion-token
# NOTION_USER_PROFILE_PAGE_ID=your-profile-page-id

# Optional: Notion knowledge database (MemorizeInformation + search). Database needs one Title property (default "Name"). See README for database ID and sharing.
# NOTION_KNOWLEDGE_DATABASE_ID=your-database-id
# NOTION_KNOWLEDGE_TITLE_PROPERTY=Name

# Optional: Qdrant (SearchKnowledgeBase + MemorizeInformation). Use gRPC port 6334; collection created automatically (default "knowledge"). See README "Optional: Qdrant".
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6334
# QDRANT_COLLECTION=knowledge

# Optional: tunables (defaults in internal/config)
# MEMORIZE_TOPIC_SIMILARITY_THRESHOLD=0.85
# WORKING_MEMORY_SIZE=20
# CHAT_TOOL_LOOP_MAX_ITER=10
# CHAT_DEFAULT_MAX_TOKENS=2048
# CHAT_DEFAULT_TEMPERATURE=0.7
# KB_MAX_TEXT_CHARS=6000
# KB_RRF_K=60
# KB_SEARCH_PREFETCH_MIN=20
